[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Script/UI/pause_panel.gd" id="1_pause"]

[node name="PausePanel" type="Control"]
process_mode = 2
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.72)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -220.0
offset_right = 240.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 26

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "游戏暂停"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.75, 1)
theme_override_font_sizes/font_size = 18
text = "当前进度会在“重新开始”后清空"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(360, 84)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "继续游戏"

[node name="RestartButton" type="Button" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(360, 84)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "重新开始"

[node name="MenuButton" type="Button" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(360, 84)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "返回主菜单"

[connection signal="pressed" from="Panel/Margin/VBox/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/MenuButton" to="." method="_on_menu_button_pressed"]
